# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Secrets. Leapfrog L3, 2026-08-09.
# `.env*` is deliberately broader than `.env*.local`. The narrower pattern is what let
# ai-policy-tool/.env and whatshuman/.env.production become tracked files: neither ends in
# `.local`, so nothing stopped them. The negation keeps deliberate *.example templates tracked.
# `.credentials.local` holds minted passphrases in plaintext (vault, roam). They cannot be
# recovered from an argon2 hash, so the local copy is the only record and it must never travel.
.env*
!.env*.example
.credentials.local
*.credentials.local

# Claude Code session state (per-machine; launch.json stays tracked where it already is)
.claude/
